     <rdf:li rdf:parseType="Resource">
      <pdfd:conformsTo>http://pdfa.org/declarations/wtpdf#reuse1.0</pdfd:conformsTo>
      <pdfd:claimData>
       <rdf:Bag>
        <rdf:li rdf:parseType="Resource">
         <pdfd:claimBy>LaTeX Project</pdfd:claimBy>
         <pdfd:claimDate>2026-09-01</pdfd:claimDate>
        </rdf:li>
       </rdf:Bag>
      </pdfd:claimData>
